{
  "name": "@govindkm/mdtopdf-converter",
  "version": "1.0.0",
  "description": "A powerful CLI tool for converting Markdown and HTML files to PDF with 10 built-in templates, dark theme support, and custom template management",
  "main": "dist/cli/index.js",
  "bin": {
    "mdtopdf": "dist/cli/index.js"
  },
  "directories": {
    "example": "examples",
    "test": "tests"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "TEMPLATE_GUIDE.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "npm run build && node dist/cli/index.js --version && node dist/cli/index.js --help",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "prepare": "husky install",
    "version:patch": "npm version patch && git push origin master --follow-tags",
    "version:minor": "npm version minor && git push origin master --follow-tags",
    "version:major": "npm version major && git push origin master --follow-tags",
    "check-version": "node -p \"'Local: ' + require('./package.json').version\" && echo \"NPM: $(npm view @govindkm/mdtopdf-converter version 2>/dev/null || echo 'not published')\"",
    "release": "npm run build && npm run test:ci && npm publish --access=public"
  },
  "keywords": [
    "markdown",
    "html",
    "pdf",
    "converter",
    "cli",
    "dark-theme",
    "templates",
    "puppeteer",
    "nodejs",
    "typescript",
    "command-line",
    "document-conversion",
    "pdf-generation"
  ],
  "author": {
    "name": "govindkm",
    "email": "your-email@example.com"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/govindkm/mdtopdf-converter.git"
  },
  "bugs": {
    "url": "https://github.com/govindkm/mdtopdf-converter/issues"
  },
  "homepage": "https://github.com/govindkm/mdtopdf-converter#readme",
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/glob": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "fs-extra": "^11.3.2",
    "glob": "^11.0.3",
    "marked": "^16.3.0",
    "puppeteer": "^24.22.3",
    "upath": "^2.0.1"
  }
}
